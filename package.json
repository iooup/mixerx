{
  "name": "mixerx",
  "version": "2.0.0-alpha.0",
  "description": "Local-first browser DJ instrument with a WebMCP agent co-pilot and a structure-aware WebGPU stage.",
  "license": "AGPL-3.0-or-later",
  "author": "Ayob <ayob8986@gmail.com>",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:site": "npm run build && npm run check:csp && npm run check:size && vite build --config mixerx/vite.config.mjs && node scripts/prepare-sites-build.mjs --include-introduction && npm run check:csp",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:csp": "node scripts/check-csp.mjs",
    "check:size": "node scripts/check-build-size.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:csp && npm run check:size",
    "corpus": "playwright test -c playwright.corpus.config.ts",
    "test:soak": "playwright test -c playwright.soak.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@fontsource/syne": "5.3.0",
    "lucide-react": "1.42.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "@types/audioworklet": "^0.0.100",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@webgpu/types": "0.1.72",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
